<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Package Metadata adhering to Microsoft Package Authoring Best Practices -->
    <PackageId>Ecitizen.PesaflowGateway.AspNetCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Modi97, Jose Modi</Authors>
    <Company>Modi97</Company>
    <Copyright>Copyright (c) 2026 Jose Modi</Copyright>
    <Description>ASP.NET Core integration for Kenya's eCitizen / PesaFlow PaymentAPI. Provides dependency injection extensions, Minimal API webhook endpoint mapping (MapEcitizenWebhook), and MVC webhook processing.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JoseModi97/ecitizen-pesaflow-gateway-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JoseModi97/ecitizen-pesaflow-gateway-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ecitizen;pesaflow;aspnetcore;minimalapi;mpesa;kenya;payments;webhook</PackageTags>
    <PackageReleaseNotes>Initial 1.0.0 release of Ecitizen.PesaflowGateway.AspNetCore for .NET 8 and .NET 10.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Source Link & Debug Symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ecitizen.PesaflowGateway\Ecitizen.PesaflowGateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
