<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
    
    <!-- Package Metadata adhering to Microsoft Package Authoring Best Practices -->
    <PackageId>Ecitizen.PesaflowGateway</PackageId>
    <Version>1.0.1</Version>
    <Authors>Modi97, Jose Modi</Authors>
    <Company>Modi97</Company>
    <Copyright>Copyright (c) 2026 Jose Modi</Copyright>
    <Description>Idiomatic .NET client for Kenya's eCitizen and PesaFlow PaymentAPI (M-Pesa STK push, checkout forms, IPN webhook signature verification). Minimal-dependency core with exact HMAC-SHA256 wire parity.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JoseModi97/ecitizen-pesaflow-gateway-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JoseModi97/ecitizen-pesaflow-gateway-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ecitizen;pesaflow;mpesa;kenya;payments;paymentapi;stkpush;checkout;ipn;webhook</PackageTags>
    <PackageReleaseNotes>1.0.1: Documentation updates, added multi-platform examples repository index, and verified .NET 8/10 compatibility.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Source Link & Debug Symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
